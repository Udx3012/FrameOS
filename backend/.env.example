# FrameOS media agent — copy to .env and fill in. Never commit real values.

# ── Primary LLM Configuration (Gemini API / Google AI Studio) ──
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# ── OPTIONAL: AgentRouter Configuration ──
# To use your AgentRouter credits (e.g. gpt-5.5, opus4.8, glm-5.2), uncomment the lines below
# and comment out the Gemini API lines above:
#
# LLM_API_KEY=your_agentrouter_api_key
# LLM_BASE_URL=https://api.agentrouter.ai/v1
# LLM_MODEL=gpt-5.5

# ── OPTIONAL: OpenAI Configuration ──
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ── Voice + Transcription ──
# Whisper (Groq is 100% FREE & extremely fast for speech-to-text)
WHISPER_API_KEY=your_groq_api_key_here
WHISPER_BASE_URL=https://api.groq.com/openai/v1

ELEVENLABS_API_KEY=          # generated voice-over (Generate mode)

# ── Telegram bot (chat gateway) — @FrameOSBot ──
TELEGRAM_BOT_TOKEN=          # from @BotFather on Telegram
TELEGRAM_ADMIN_USER_ID=      # your numeric Telegram user id (optional)

# ── Convex (web generation queue) ──
CONVEX_URL=https://your-convex-app.convex.cloud
CONVEX_DEPLOY_KEY=           # prod deploy key from `npx convex dev`

# ── Google Cloud Storage (rendered reels + signed URLs) ──
GCS_BUCKET=frameos-media-videos

# ── Payments ──
DODO_KEY=                    # Dodo Payments (checkout)

# ── Free Stock B-roll Video Sources ──
PEXELS_API_KEY=              # free at pexels.com/api (primary b-roll source)
PIXABAY_API_KEY=             # free at pixabay.com/api/docs (fallback b-roll source)

# ── Free Reaction Stickers ──
GIPHY_API_KEY=               # free at developers.giphy.com
